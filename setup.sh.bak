#!/usr/bin/env bash

# ==========================================
# Debian 13 (Trixie) - i3 & Dotfiles Setup
# ==========================================

set -eu

echo "🚀 Start systeem configuratie..."

# 1. Repositories updaten
echo "📦 Repositories updaten..."
sudo apt update
sudo apt upgrade -y

# 2. Xorg en Display Manager installeren
echo "🖥️ Xorg en LightDM installeren..."
sudo apt install -y xserver-xorg xinit lightdm lightdm-gtk-greeter light-locker

# Zorg ervoor dat de grafische login (LightDM) start bij het opstarten
sudo systemctl enable lightdm

# 3. Window Manager, Terminal en Applicaties installeren

echo "🪟 i3, Kitty, Polybar, Feh en Git installeren..."
sudo apt install -y i3 kitty polybar feh git

# ==========================================
# 4. Dotfiles Architectuur & Git Opzetten
# ==========================================
echo "📁 Dotfiles structuur voorbereiden..."

DOTFILES_DIR="$HOME/dotfiles"
CONFIG_DIR="$HOME/.config"

# Maak de dotfiles map aan en initialiseer Git als dat nog niet zo is
if [ ! -d "$DOTFILES_DIR" ]; then
    mkdir -p "$DOTFILES_DIR"
    echo "🔧 Git repository initialiseren in $DOTFILES_DIR..."
    git -C "$DOTFILES_DIR" init
    # Later voegen we hier logica toe om te 'clonen' in plaats van 'init' voor je andere machines
fi

mkdir -p "$CONFIG_DIR"

APPS=("i3" "kitty" "polybar" "feh")

for app in "${APPS[@]}"; do
    TARGET_DIR="$CONFIG_DIR/$app"
    SOURCE_DIR="$DOTFILES_DIR/$app"

    # Maak de map aan in je dotfiles repository
    mkdir -p "$SOURCE_DIR"

    # Check of de symlink al correct bestaat
    if [ -L "$TARGET_DIR" ] && [ "$(readlink "$TARGET_DIR")" = "$SOURCE_DIR" ]; then
        echo "✅ Symlink voor $app staat al goed."
    else
        # Als er al een map of bestand staat, maak een backup
        if [ -e "$TARGET_DIR" ] || [ -L "$TARGET_DIR" ]; then
            echo "⚠️ Bestaande configuratie gevonden voor $app. Backup maken naar ${TARGET_DIR}.bak..."
            mv "$TARGET_DIR" "${TARGET_DIR}.bak"
        fi
        
        # Maak de symlink aan
        echo "🔗 Symlink maken: $TARGET_DIR -> $SOURCE_DIR"
        ln -s "$SOURCE_DIR" "$TARGET_DIR"
    fi
done

echo "🎉 Setup voltooid! Je basis en Git-repo staan klaar."
