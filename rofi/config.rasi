configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "ColorEngine-Apps";   /* generated by scripts/rofi-icons.sh */
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    display-drun: "   Apps ";
}

/* Font: active font module (scripts/menu-font.sh, $mod+Shift+f) */
@import "~/.cache/theme/rofi-font.rasi"

/* UI scale: DPI (scripts/ui-scale.sh, $mod+Shift+plus/minus) */
@import "~/.cache/theme/ui-scale.rasi"

@theme "theme"
