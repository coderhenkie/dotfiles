# i3 config file (v4)
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

# Load the dynamic theme from the Color Engine
include ~/.cache/theme/i3.conf

# Load local hotkeys and $mod configuration (bootstrapped from hotkeys.default, ignored by Git)
include ~/.config/i3/hotkeys.conf

# Use the installed JetBrainsMono Nerd Font
font pango:JetBrainsMono Nerd Font 10

# Window borders and subtle gaps between windows
default_border pixel 3
default_floating_border pixel 3
for_window [class="^.*"] border pixel 3
# Polybar calendar popup (scripts/calendar.sh) floats at its requested position
for_window [class="^Calendar$"] floating enable, sticky enable
gaps inner 4
gaps outer 1

# ==========================================
# AUTOSTART & APPEARANCE
# ==========================================

# Start XDG autostart .desktop files using dex
exec --no-startup-id dex --autostart --environment i3

# Ensure light-locker daemon is running for session and idle locking
exec_always --no-startup-id sh -c 'pgrep -x light-locker >/dev/null || light-locker --lock-after-screensaver=5 --no-late-locking --lock-on-suspend &'

# Enable automatic idle lock after 5 minutes (300s) while keeping DPMS monitor power-off disabled in the VM
exec_always --no-startup-id xset s 300 5 -dpms

# NetworkManager applet
exec --no-startup-id nm-applet

# Launch Polybar (replaces default i3bar)
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Always restore the last selected wallpaper
exec_always --no-startup-id ~/.fehbg

# Start Picom for shadows, rounded corners, and transparency
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf -b

# Swap CapsLock and Escape
exec_always --no-startup-id setxkbmap -option caps:swapescape

# Merge Xresources
exec --no-startup-id xrdb -merge ~/.Xresources
