# Font module for scripts/font-picker.sh ($mod+Shift+f). Sourced by scripts/lib/fonts.sh.
FONT_NAME="Iosevka"
FONT_DESCRIPTION="Narrow and tall, fits a lot on screen (tiling WMs, split panes)"
FONT_ASSET="Iosevka.tar.xz"              # release asset in github.com/ryanoasis/nerd-fonts (checksum-verified)
FONT_FILE_PREFIX="IosevkaNerdFont"        # files kept: <prefix>-<Style>.ttf and <prefix>Mono-<Style>.ttf
FONT_FAMILY="Iosevka Nerd Font"             # UI: Polybar, i3, Rofi, dunst, GTK, LightDM, Zathura, Spotify, web pages
FONT_FAMILY_MONO="Iosevka Nerd Font Mono"   # Kitty: every icon exactly one cell wide
