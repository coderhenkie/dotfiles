# Font module for scripts/font-picker.sh ($mod+Shift+f). Sourced by scripts/lib/fonts.sh.
FONT_NAME="Source Code Pro"
FONT_DESCRIPTION="Adobe's open-source coding font, calm and balanced"
FONT_ASSET="SourceCodePro.tar.xz"              # release asset in github.com/ryanoasis/nerd-fonts (checksum-verified)
FONT_FILE_PREFIX="SauceCodeProNerdFont"        # files kept: <prefix>-<Style>.ttf and <prefix>Mono-<Style>.ttf
FONT_FAMILY="SauceCodePro Nerd Font"             # UI: Polybar, i3, Rofi, dunst, GTK, LightDM, Zathura, Spotify, web pages
FONT_FAMILY_MONO="SauceCodePro Nerd Font Mono"   # Kitty: every icon exactly one cell wide
