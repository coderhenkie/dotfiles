# ==========================================
# i3 Default Hotkeys Blueprint (Tracked in Git)
# ==========================================
# On first install, this file is copied to ~/.config/i3/hotkeys.conf
# (which is ignored by Git so local hotkey and $mod changes never cause merge conflicts).

set $mod Mod1

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Move tiling windows via drag & drop by left-clicking into the title bar
tiling_drag modifier titlebar

# Custom Rofi Menus, Theme Engine & Screen Lock
bindsym $mod+Shift+w exec --no-startup-id ~/dotfiles/scripts/theme-selector.sh
bindsym $mod+t exec --no-startup-id ~/dotfiles/scripts/ai-theme.sh
bindsym $mod+m exec --no-startup-id ~/dotfiles/scripts/hotkey-menu.sh
bindsym $mod+Shift+x exec --no-startup-id ~/dotfiles/scripts/lock.sh

# Notifications: toggle silent mode / open notification menu
bindsym $mod+n exec --no-startup-id ~/dotfiles/scripts/notifications.sh toggle
bindsym $mod+Shift+n exec --no-startup-id ~/dotfiles/scripts/notifications.sh menu

# Area screenshot -> ~/Pictures + clipboard
bindsym Control+Shift+t exec --no-startup-id ~/dotfiles/scripts/screenshot.sh

# Rofi tools: clipboard history, calculator, emoji picker, font picker
bindsym $mod+c exec --no-startup-id ~/dotfiles/scripts/clipboard.sh menu
bindsym $mod+equal exec --no-startup-id ~/dotfiles/scripts/calculator.sh
bindsym $mod+Shift+period exec --no-startup-id ~/dotfiles/scripts/emoji.sh
bindsym $mod+Shift+f exec --no-startup-id ~/dotfiles/scripts/font-picker.sh

# Volume controls (managed via PulseAudio / PipeWire; Polybar handles status display)
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Start a terminal
bindsym $mod+Return exec kitty

# Kill focused window
bindsym $mod+q kill

# Start Rofi application launcher
bindsym $mod+space exec --no-startup-id "rofi -show drun"

# Change focus (Vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Change focus (Cursor keys)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window (Vim keys)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Move focused window (Cursor keys)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split in horizontal / vertical orientation
bindsym $mod+b split h
bindsym $mod+v split v

# Enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+d focus mode_toggle

# Focus the parent container
bindsym $mod+a focus parent

# Define names for default workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload / Restart i3 & power menu (lock, suspend, log out, reboot, shut down)
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id ~/dotfiles/scripts/power-menu.sh

# Resize window mode
mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"
