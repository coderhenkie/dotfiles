# ==========================================
# Dunst Notification Daemon (Minimal, Bottom-Right)
# ==========================================
# Layout only. Colors are generated by scripts/apply-theme.sh into
# ~/.cache/theme/dunst.conf, symlinked as dunstrc.d/99-color-engine.conf
# (dunst loads drop-ins after this file, so the theme colors win).

[global]
    monitor = 0
    follow = mouse

    # Bottom-right, just above the bottom Polybar (27px) with a small gap
    origin = bottom-right
    offset = (10, 37)
    width = (200, 360)
    height = (0, 160)
    notification_limit = 4
    stack_duplicates = true
    hide_duplicate_count = false
    indicate_hidden = true

    # Look
    font = Iosevka Nerd Font 8
    padding = 6
    horizontal_padding = 8
    text_icon_padding = 8
    gap_size = 4
    separator_height = 0
    frame_width = 2
    corner_radius = 4
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3

    # Text
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = true
    ellipsize = end
    ignore_newline = false
    show_age_threshold = 60

    # Icons (screenshots show a thumbnail)
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    # History & mouse
    sticky_history = true
    history_length = 20
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

    # Picom already handles rounded corners/shadows; keep dunst's own effects off
    transparency = 0
    browser = /usr/bin/xdg-open

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 6

[urgency_critical]
    timeout = 0
