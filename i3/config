# i3 config file (v4)
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

# Load the dynamic theme from the Color Engine
include ~/.cache/theme/i3.conf

# Load local hotkeys and $mod configuration (bootstrapped from hotkeys.default, ignored by Git)
include ~/.config/i3/hotkeys.conf
# Workspace -> screen assignment (2 screens: 1-4 left, 5-10 right), generated by scripts/workspaces.sh
include ~/.cache/theme/workspaces.conf

# Font: set by the active font module in ~/.cache/theme/i3.conf (included above, $mod+Shift+f)

# Window borders and subtle gaps between windows
default_border pixel 3
default_floating_border pixel 3
for_window [class="^.*"] border pixel 3
# Polybar calendar popup (scripts/calendar.sh) floats at its requested position
for_window [class="^Calendar$"] floating enable, sticky enable
gaps inner 4
gaps outer 1

# ==========================================
# AUTOSTART & APPEARANCE
# ==========================================

# Start XDG autostart .desktop files using dex
exec --no-startup-id dex --autostart --environment i3

# Ensure light-locker daemon is running for session and idle locking
exec_always --no-startup-id sh -c 'pgrep -x light-locker >/dev/null || light-locker --lock-after-screensaver=5 --no-late-locking --lock-on-suspend &'

# Enable automatic idle lock after 3 minutes (175s screensaver + 5s light-locker grace) while keeping DPMS monitor power-off disabled in the VM
exec_always --no-startup-id xset s 175 5 -dpms

# Suspend after 30 minutes locked (bare metal only; exits immediately in a VM)
exec --no-startup-id ~/dotfiles/scripts/lock-suspend.sh

# NetworkManager: no tray applet; Wi-Fi status/menu is the polybar wifi module (click: menu-wifi.sh, right-click: nmtui)

# Polkit agent: password prompts for GUI apps that need admin rights (Thunar mounts, Timeshift, ...)
exec --no-startup-id /usr/libexec/polkit-mate-authentication-agent-1

# Clipboard history watcher ($mod+c) and low-battery warnings (exits on machines without a battery)
exec --no-startup-id ~/dotfiles/scripts/menu-clipboard.sh daemon
exec --no-startup-id ~/dotfiles/scripts/battery-notify.sh
# Obsidian Sync via Obsidian Headless while the app is closed (notes edited in Neovim); hands over to the app's own Sync while it runs
exec --no-startup-id ~/dotfiles/scripts/obsidian-sync.sh daemon

# Keep Thorium up to date (checksum-verified; notifies only when it updated)
exec --no-startup-id ~/dotfiles/scripts/update-thorium.sh --quiet

# Apply the monitor layout at login: a saved autorandr profile if one matches,
# otherwise mirror every connected screen (HDMI/TV) via the `default` -> `common` fallback
exec --no-startup-id autorandr --change --default default

# Assign workspaces to the screens (only reloads i3 when the assignment changed, so no reload loop)
exec_always --no-startup-id ~/dotfiles/scripts/workspaces.sh

# Launch Polybar (replaces default i3bar)
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Always restore the last selected wallpaper
exec_always --no-startup-id ~/.fehbg

# Start Picom for shadows, rounded corners, and transparency
# Compositor: picks glx on bare metal, xrender in a VM (scripts/picom-launch.sh)
exec_always --no-startup-id ~/dotfiles/scripts/picom-launch.sh

# Swap CapsLock and Escape
exec_always --no-startup-id setxkbmap -option caps:swapescape

# Merge Xresources
# Merge ~/.Xresources (base DPI) and apply the saved UI scale ($mod+Shift+plus/minus)
exec --no-startup-id ~/dotfiles/scripts/ui-scale.sh apply
