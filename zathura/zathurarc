# ==========================================
# Zathura PDF Viewer (vim keys)
# ==========================================
# Colors are generated by scripts/apply-theme.sh into ~/.cache/theme/zathurarc,
# symlinked here as colors.zathurarc (ignored by Git).

# Font: set by the active font module in colors.zathurarc ($mod+Shift+f)
set selection-clipboard clipboard
set adjust-open "best-fit"
set scroll-page-aware "true"
set smooth-scroll "true"
set statusbar-h-padding 8
set statusbar-v-padding 4
set window-title-basename "true"
set recolor-keephue "true"

include colors.zathurarc
