# Font module for scripts/menu-font.sh ($mod+Shift+f). Sourced by scripts/lib/fonts.sh.
FONT_NAME="Hack"
FONT_DESCRIPTION="Clean and legible, no ligatures"
FONT_ASSET="Hack.tar.xz"              # release asset in github.com/ryanoasis/nerd-fonts (checksum-verified)
FONT_FILE_PREFIX="HackNerdFont"        # files kept: <prefix>-<Style>.ttf and <prefix>Mono-<Style>.ttf
FONT_FAMILY="Hack Nerd Font"             # UI: Polybar, i3, Rofi, dunst, GTK, LightDM, Zathura, Spotify, web pages
FONT_FAMILY_MONO="Hack Nerd Font Mono"   # Kitty: every icon exactly one cell wide
