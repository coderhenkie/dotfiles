#!/usr/bin/env bash
# ==========================================
# Autorandr Postswitch Hook
# ==========================================
# Runs after every monitor layout switch (plug/unplug, lid, `autorandr --change`).
# Re-launches Polybar, re-assigns the workspaces and re-applies the wallpaper so both fit the new layout.
#
# Usage: postswitch [-h|--help]

# No set -e: background hook commands should all be launched even if one fails.
set -uo pipefail

# shellcheck source-path=SCRIPTDIR source=../scripts/lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../scripts/lib/common.sh"

case "${1:-}" in
    -h|--help) help_from_header; exit 0 ;;
esac

"$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
# 2 screens: workspaces 1-4 on the left screen, 5-10 on the right one
"$DOTFILES_DIR/scripts/workspaces.sh" >/dev/null 2>&1 &
[ -x "$HOME/.fehbg" ] && "$HOME/.fehbg" >/dev/null 2>&1 &
notify -a "Display" -u low "Display layout: ${AUTORANDR_CURRENT_PROFILE:-changed}" &
