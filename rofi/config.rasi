configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "ColorEngine-Apps";   /* generated by scripts/rofi-icons.sh */
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    display-drun: "   Apps ";
}

/* Font: active font module (scripts/font-picker.sh, $mod+Shift+f) */
@import "~/.cache/theme/rofi-font.rasi"

@theme "theme"
