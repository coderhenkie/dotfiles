# --- Shadows ---
shadow = true;
shadow-radius = 12;
shadow-opacity = 0.50;
shadow-offset-x = -12;
shadow-offset-y = -12;

# Exclude Polybar from shadows
shadow-exclude = [
    "class_g = 'Polybar'"
];

# --- Opacity ---
inactive-opacity = 0.85;
active-opacity = 1.0;
frame-opacity = 1.0;

# Keep Rofi and Polybar at 100% opacity
opacity-rule = [
    "100:class_g = 'Rofi'",
    "100:class_g = 'Polybar'"
];

# --- Rounded Corners ---
corner-radius = 8;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "class_g = 'Polybar'"
];

# --- Performance (Smooth rendering) ---
backend = "xrender";
vsync = true;
